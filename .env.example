# Cloudflare Workers AI (REST API)
# https://dash.cloudflare.com/ → My Profile → API Tokens
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare Workers AI model to use for chat
# See available models: https://developers.cloudflare.com/workers-ai/models/
# Default: @cf/openai/gpt-oss-120b (function calling support)
CLOUDFLARE_WORKERS_AI_MODEL=@cf/openai/gpt-oss-120b

# BirdXplorer REST API base URL
# Default: https://dev.api-birdxplorer.code4japan.org
BIRDXPLORER_API_URL=https://dev.api-birdxplorer.code4japan.org

# (Optional) API key for BirdXplorer CSV export endpoint
# EXPORT_API_KEY=

# Basic Auth credentials for /export page
# EXPORT_BASIC_AUTH_USER=
# EXPORT_BASIC_AUTH_PASSWORD=
